<Project>
  <PropertyGroup>
    <!-- Supply-chain: audit direct AND transitive packages on every restore and fail the build on known vulnerabilities. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <!-- Deterministic, reproducible builds -->
    <Deterministic>true</Deterministic>
    <!-- 2.7.0 supply chain: SourceLink (built into the .NET SDK) maps symbols to the exact commit; untracked generated sources are embedded. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- 2.7.0: Microsoft.CodeAnalysis.NetAnalyzers security rules (CA2xxx/CA3xxx/CA5xxx) on every build. -->
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
