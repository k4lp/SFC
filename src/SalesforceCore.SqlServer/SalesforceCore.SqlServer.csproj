<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageId>SalesforceCore.SqlServer</PackageId>
    <Version>2.0.0</Version>
    <Authors>SalesforceCore Contributors</Authors>
    <Description>SQL Server add-ons for SalesforceCore: AES-256-GCM encrypted IDistributedCache (write-behind access tracking, cleanup service) and sp_getapplock distributed locks. Split out of the core package in 2.0 so the core client no longer depends on Entity Framework Core.</Description>
    <PackageTags>salesforce;sqlserver;distributed-cache;encryption;dotnet</PackageTags>
    <PackageProjectUrl>https://github.com/k4lp/SFC</PackageProjectUrl>
    <RepositoryUrl>https://github.com/k4lp/SFC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RootNamespace>SalesforceCore</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SalesforceCore\SalesforceCore.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="SalesforceCore.Tests" />
  </ItemGroup>
</Project>
