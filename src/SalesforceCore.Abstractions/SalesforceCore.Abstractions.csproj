<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageId>SalesforceCore.Abstractions</PackageId>
    <Version>2.1.0</Version>
    <Authors>SalesforceCore Contributors</Authors>
    <Description>Dependency-free contracts for the SalesforceCore ecosystem: ISalesforceClient, ITokenProvider, SalesforceRequest/SalesforceResponse, SalesforceApiVersion, the SalesforceException hierarchy and the Salesforce error mapper. Reference this from add-on packages (auth providers, handlers, test doubles) instead of the full client.</Description>
    <PackageTags>salesforce;abstractions;rest-api;dotnet</PackageTags>
    <PackageProjectUrl>https://github.com/k4lp/SFC</PackageProjectUrl>
    <RepositoryUrl>https://github.com/k4lp/SFC</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RootNamespace>SalesforceCore</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="SalesforceCore" />
    <InternalsVisibleTo Include="SalesforceCore.Tests" />
  </ItemGroup>
</Project>
