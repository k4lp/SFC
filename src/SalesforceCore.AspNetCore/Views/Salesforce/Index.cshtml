@model ListViewModel
@{
    ViewData["Title"] = Model.ObjectLabelPlural;
    var enableHtmx = Model.MvcOptions.EnableHtmx;
    var showRecordIds = Model.MvcOptions.ShowRecordIds;
}

<div class="sf-list-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">
                @if (Model.ModuleConfig?.Icon != null)
                {
                    <i class="@Model.ModuleConfig.Icon me-2"></i>
                }
                @Model.ObjectLabelPlural
            </h1>
        </div>
        <div class="d-flex gap-2">
            @if (Model.CanCreate)
            {
                <a href="@Url.Action("Create", new { sObject = Model.SObject })"
                   class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i> New @Model.ObjectLabel
                </a>
            }
        </div>
    </div>

    <!-- Search and Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        @if (enableHtmx)
                        {
                            <input type="text"
                                   name="q"
                                   class="form-control"
                                   placeholder="Search @Model.ObjectLabelPlural..."
                                   value="@Model.SearchQuery"
                                   hx-get="@Url.Action("Index", new { sObject = Model.SObject })"
                                   hx-trigger="keyup changed delay:300ms"
                                   hx-target=".sf-list-container"
                                   hx-push-url="true" />
                        }
                        else
                        {
                            <input type="text"
                                   name="q"
                                   class="form-control"
                                   placeholder="Search @Model.ObjectLabelPlural..."
                                   value="@Model.SearchQuery" />
                        }
                        @if (!string.IsNullOrEmpty(Model.SearchQuery))
                        {
                            <a href="@Url.Action("Index", new { sObject = Model.SObject })"
                               class="btn btn-outline-secondary">
                                <i class="fas fa-times"></i>
                            </a>
                        }
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="pageSize" class="form-select" onchange="this.form.submit()">
                        <option value="10" selected="@(Model.PageSize == 10)">10 per page</option>
                        <option value="25" selected="@(Model.PageSize == 25)">25 per page</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50 per page</option>
                        <option value="100" selected="@(Model.PageSize == 100)">100 per page</option>
                    </select>
                </div>
            </form>
        </div>
    </div>

    <!-- Records Table -->
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        @foreach (var fieldName in Model.Fields)
                        {
                            var field = Model.FieldDefinitions.GetValueOrDefault(fieldName);
                            var label = field?.Label ?? fieldName;
                            var isSortable = field?.Sortable ?? false;
                            var isCurrentSort = Model.OrderBy == fieldName;

                            <th>
                                @if (isSortable)
                                {
                                    var newDesc = isCurrentSort ? !Model.OrderDescending : false;
                                    <a href="@Url.Action("Index", new { sObject = Model.SObject, q = Model.SearchQuery, orderBy = fieldName, desc = newDesc })"
                                       class="text-decoration-none text-dark">
                                        @label
                                        @if (isCurrentSort)
                                        {
                                            <i class="fas fa-sort-@(Model.OrderDescending ? "down" : "up") ms-1"></i>
                                        }
                                    </a>
                                }
                                else
                                {
                                    @label
                                }
                            </th>
                        }
                        @if (showRecordIds)
                        {
                            <th>Record ID</th>
                        }
                        <th style="width: 100px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Records.Count == 0)
                    {
                        <tr>
                            <td colspan="@(Model.Fields.Count + (showRecordIds ? 2 : 1))" class="text-center py-5 text-muted">
                                <i class="fas fa-inbox fa-3x mb-3"></i>
                                <p class="mb-0">No @Model.ObjectLabelPlural.ToLower() found.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var record in Model.Records)
                    {
                        var recordId = record["Id"]?.ToString();
                        <tr>
                            @foreach (var fieldName in Model.Fields)
                            {
                                var value = record[fieldName]?.ToString() ?? "";
                                var field = Model.FieldDefinitions.GetValueOrDefault(fieldName);

                                <td>
                                    @if (fieldName == Model.Fields.First() && !string.IsNullOrEmpty(recordId))
                                    {
                                        <a href="@Url.Action("Details", new { sObject = Model.SObject, id = recordId })">
                                            @(string.IsNullOrEmpty(value) ? recordId : value)
                                        </a>
                                    }
                                    else if (field != null)
                                    {
                                        @FieldTypeConverter.FormatForDisplay(field, value)
                                    }
                                    else
                                    {
                                        @value
                                    }
                                </td>
                            }
                            @if (showRecordIds)
                            {
                                <td class="font-monospace small">@recordId</td>
                            }
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="@Url.Action("Details", new { sObject = Model.SObject, id = recordId })"
                                       class="btn btn-outline-secondary" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="@Url.Action("Edit", new { sObject = Model.SObject, id = recordId })"
                                       class="btn btn-outline-secondary" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.HasPreviousPage || Model.HasNextPage)
        {
            <div class="card-footer">
                <nav class="d-flex justify-content-between align-items-center">
                    <div>
                        Page @Model.CurrentPage
                    </div>
                    <div class="btn-group">
                        @if (Model.HasPreviousPage)
                        {
                            <a href="@Url.Action("Index", new { sObject = Model.SObject, q = Model.SearchQuery, page = Model.CurrentPage - 1, pageSize = Model.PageSize, orderBy = Model.OrderBy, desc = Model.OrderDescending })"
                               class="btn btn-outline-primary">
                                <i class="fas fa-chevron-left"></i> Previous
                            </a>
                        }
                        @if (Model.HasNextPage)
                        {
                            <a href="@Url.Action("Index", new { sObject = Model.SObject, q = Model.SearchQuery, page = Model.CurrentPage + 1, pageSize = Model.PageSize, orderBy = Model.OrderBy, desc = Model.OrderDescending })"
                               class="btn btn-outline-primary">
                                Next <i class="fas fa-chevron-right"></i>
                            </a>
                        }
                    </div>
                </nav>
            </div>
        }
    </div>
</div>
